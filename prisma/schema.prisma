// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  password    String
  company     String?
  createdAt   DateTime     @default(now())
  competitors Competitor[]
  alerts      Alert[]
  reports     Report[]
}

model Competitor {
  id          String        @id @default(cuid())
  name        String
  website     String
  industry    String
  description String
  threatLevel String        @default("medium")
  logo        String
  color       String        @default("#4F46E5")
  founded     Int?
  employees   String?
  revenue     String?
  marketShare Float         @default(0)
  lastUpdated String
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  pricingPlans PricingPlan[]
  features    Feature[]
  news        CompetitorNews[]
  alerts      Alert[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PricingPlan {
  id           String     @id @default(cuid())
  name         String
  price        Float
  currency     String     @default("€")
  interval     String     @default("mois")
  features     String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model Feature {
  id           String     @id @default(cuid())
  name         String
  available    Boolean    @default(true)
  quality      String     @default("Bien")
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model CompetitorNews {
  id           String     @id @default(cuid())
  date         String
  title        String
  type         String
  competitorId String
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
}

model Alert {
  id           String     @id @default(cuid())
  type         String
  message      String
  isRead       Boolean    @default(false)
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now())
}

model Report {
  id          String   @id @default(cuid())
  title       String
  description String
  pages       Int      @default(10)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

// ─── Module Prospection (agents orchestrateurs) ─────────────────────────────

model Prospect {
  id            String            @id @default(cuid())
  name          String
  category      String
  city          String
  address       String?
  phone         String?
  email         String?
  googlePlaceId String?           @unique
  rating        Float?
  reviewCount   Int               @default(0)
  score         Int               @default(0)
  status        String            @default("new") // new | qualified | contacted | followup | replied | won | lost | optout
  source        String            @default("places") // places | csv | manual
  optOut        Boolean           @default(false)
  optOutToken   String            @unique @default(cuid())
  notes         String?
  messages      OutreachMessage[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model OutreachMessage {
  id           String    @id @default(cuid())
  prospectId   String
  prospect     Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  step         Int // 1 initial | 2 relance | 3 valeur | 4 breakup
  channel      String    @default("email")
  subject      String
  body         String
  status       String    @default("draft") // draft | scheduled | sent | failed | skipped
  scheduledFor DateTime?
  sentAt       DateTime?
  error        String?
  createdAt    DateTime  @default(now())
}

model AgentRun {
  id         String    @id @default(cuid())
  agent      String // orchestrator | scout | qualifier | copywriter | sequencer | mailer
  status     String    @default("running") // running | success | error
  input      String? // JSON
  output     String? // JSON (résumé chiffré du run)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}
