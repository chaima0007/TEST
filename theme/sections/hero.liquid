{% comment %}
  Section héros de la page d'accueil : proposition de valeur en un écran,
  appel à l'action et bandeau de transparence livraison. Mobile d'abord.
{% endcomment %}

<div class="hero full-width{% if section.settings.image != blank %} hero--has-image{% endif %}">
  {% if section.settings.image != blank %}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '600, 900, 1200, 1800, 2400',
          sizes: '100vw',
          fetchpriority: 'high',
          alt: section.settings.image_alt
      }}
    </div>
  {% endif %}

  <div class="hero__inner">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 class="hero__title">{{ section.settings.heading }}</h1>

      {% if section.settings.subheading != blank %}
        <div class="hero__subheading measure">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="button button--primary hero__cta" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

      {% if section.settings.show_delivery_promise %}
        <div class="hero__promise">
          {% render 'delivery-promise', layout: 'banner' %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .hero__content {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 42rem;
  }

  .hero--has-image .hero__content {
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--style-border-radius-buttons);
  }

  .hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .hero__title {
    margin: 0;
  }

  .hero__subheading {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.1rem;
  }

  .hero__promise {
    width: 100%;
    max-width: 30rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Héros",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Accessoires chiens & chats"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Le meilleur pour votre animal, livré vite et pour de vrai."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "<p>Des accessoires malins sélectionnés pour le bien-être de votre compagnon. Expédiés depuis l'Europe, livrés en 2 à 4 jours ouvrés, avec un SAV en français.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton",
      "default": "Découvrir les best-sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "checkbox",
      "id": "show_delivery_promise",
      "label": "Afficher le bandeau de livraison",
      "default": true
    },
    {
      "type": "header",
      "content": "Image de fond"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif de l'image (SEO / accessibilité)",
      "default": "Chien et chat heureux avec leurs accessoires"
    }
  ],
  "presets": [
    {
      "name": "Héros"
    }
  ]
}
{% endschema %}
