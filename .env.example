# ===========================================================================
# CompeteIQ — variables d'environnement (exemple)
# Copier ce fichier vers .env puis remplir les valeurs réelles.
# ===========================================================================

# --- Base de données (SQLite via libSQL) -----------------------------------
DATABASE_URL="file:./dev.db"

# --- Identité de l'agence (affichée dans les emails de prospection) --------
# ATTENTION : ces valeurs sont des allégations commerciales envoyées aux
# prospects. Elles doivent être EXACTES et vérifiables (art. L121-2 s.
# Code de la consommation — pratiques commerciales trompeuses).
AGENCY_NAME="CompeteIQ Studio"
# Nom de signature dans les emails
AGENCY_SENDER_NAME="L'équipe CompeteIQ Studio"
# Années d'expérience annoncées (défaut : 10) — doit être vrai !
AGENCY_YEARS_EXPERIENCE=10
AGENCY_EMAIL="contact@competeiq.io"
AGENCY_PHONE="+33 1 23 45 67 89"
AGENCY_WEBSITE="competeiq.io"
AGENCY_CITY="Paris"
# SIRET affiché dans le pied des emails (identification LCEN)
AGENCY_SIRET="123 456 789 00012"
# Offre mise en avant : prix "à partir de" en euros (défaut : 490)
AGENCY_STARTING_PRICE=490
# Délai de livraison annoncé en jours (défaut : 15)
AGENCY_DELIVERY_DAYS=15

# --- Prospection (outreach) -------------------------------------------------
# DRY-RUN PAR DÉFAUT : true => AUCUN email n'est réellement envoyé.
# Passer explicitement à false (ou utiliser le flag --live du CLI)
# pour activer l'envoi SMTP réel.
OUTREACH_DRY_RUN=true
# Quota d'envois par jour (défaut : 50) — rester raisonnable
OUTREACH_DAILY_LIMIT=50
# Score minimal de qualification pour contacter un prospect (défaut : 30)
OUTREACH_MIN_SCORE=30
# URL publique de l'app (liens de désinscription dans les emails)
PUBLIC_BASE_URL="http://localhost:3000"

# --- Google Places (découverte d'entreprises sans site) ---------------------
# Activer "Places API (New)" dans Google Cloud Console puis créer une clé.
GOOGLE_PLACES_API_KEY="votre-cle-google-places"

# --- SMTP (envoi des emails) -------------------------------------------------
SMTP_HOST="smtp.exemple.fr"
SMTP_PORT=587
SMTP_USER="contact@competeiq.io"
SMTP_PASS="mot-de-passe-smtp"
# Expéditeur affiché (défaut : "AGENCY_NAME <AGENCY_EMAIL>")
SMTP_FROM="CompeteIQ Studio <contact@competeiq.io>"
