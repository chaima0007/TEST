# CompeteIQ — environment variables
# Copy to .env.local (Next.js) — never commit real values.

# Shopify app credentials, from the Dev Dashboard (or filled by `shopify app dev`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Admin API version used by the server-side GraphQL client.
SHOPIFY_API_VERSION=2026-07

# Optional. Domain (xxx.myshopify.com) of the store served by the public order
# tracking page /suivi/[orderId]. Not a secret. If unset, the app uses the only
# installed store in the DB; with none, the tracking page falls back to demo data.
SHOPIFY_STORE_DOMAIN=
