# ── Modèle de configuration ──────────────────────────────────────────────
# Copie ce fichier en « .env » (même dossier) et colle tes clés.
# Ne JAMAIS committer .env ni partager tes clés (le .env est ignoré par git).

# Clé Composio (créée sur dashboard.composio.dev → Manage API Keys)
COMPOSIO_API_KEY=

# Clé Anthropic. Si elle est déjà une variable d'environnement système,
# tu peux laisser cette ligne vide ; sinon colle la même clé qu'avec Mistral/Claude.
ANTHROPIC_API_KEY=

# Optionnel : identifiant utilisateur Composio (défaut : retrouvetonsmile)
COMPOSIO_USER_ID=retrouvetonsmile
