# Copiez ce fichier en ".env" et remplissez vos vraies valeurs.
# NE COMMITTEZ JAMAIS le fichier .env (il est ignore par .gitignore).

# Obligatoire
ANTHROPIC_API_KEY=sk-ant-votre_cle
MISTRAL_API_KEY=votre_cle_mistral

# Optionnel (valeurs par defaut si absentes)
CLAUDE_MODEL=claude-sonnet-4-6
MISTRAL_MODEL=mistral-large-latest

